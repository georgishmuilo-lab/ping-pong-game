from pygame import *

back = (0, 0, 180)
win_height = 600
win_width = 800
win = display.set_mode((win_width, win_height))
win.fill(back)

clock = time.Clock()
fps = 60
game = True
finish = False
countP1 = 0
countP2 = 0

font.init()
font1 = font.SysFont('Arial', 35)
lose1 = font1.render('ИГРОК №1 ПРОИГРАЛ!', True, (180, 0, 0))
lose2 = font1.render('ИГРОК №2 ПРОИГРАЛ!', True, (180, 0, 0))

class GameSprite(sprite.Sprite):
    def __init__(self, hero, x, y, speed, width=50, height=50, kup=None, kdown=None):
        super().__init__()
        self.image = transform.scale(image.load(hero), (width, height))
        self.speed = speed
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
        self.hit = False
        self.hp = 2
        self.kup = kup
        self.kdown = kdown
        self.yspeed = speed
        self.width = width
        self.height = height
    def reset(self):
        win.blit(self.image, (self.rect.x, self.rect.y))

class Player(GameSprite):
    def update(self):
        keys_pressed = key.get_pressed()
        if keys_pressed[self.kup] and self.rect.y > 0:
            self.rect.y -= self.speed
        if keys_pressed[self.kdown] and self.rect.y < 500:
            self.rect.y += self.speed

class Ball(GameSprite):
    def update(self):
        self.rect.x += self.speed
        self.rect.y += self.yspeed
        if self.rect.y <= 0 or self.rect.y >= win_height - self.height:
            self.yspeed *= -1
        

player1 = Player('player.png', 50, 250, 10, 50, 100, K_w, K_s)
player2 = Player('player.png', 700, 250, 10, 50, 100, K_UP, K_DOWN)
ball = Ball('ball.png', 375, 275, 5)




while game == True:
    for e in event.get():
        if e.type == QUIT:
            game = False
        if e.type == KEYDOWN and e.key == K_r:
            countP1 = 0
            countP2 = 0
            ball.rect.x = 375 
            ball.rect.y = 275
            player1.rect.x = 50
            player1.rect.y = 250
            player2.rect.x = 700
            player2.rect.y = 250
            ball.speed *= -1
            finish = False
    if finish == True:
        countP1 = 0
        countP2 = 0
        ball.rect.x = 375 
        ball.rect.y = 275
        ball.speed *= -1

    if finish != True:
        win.fill(back)

        text_title = font1.render('Счёт:', True, (150, 100, 100))
        text_score = font1.render(str(countP1) + ' | ' + str(countP2), True, (150, 100, 100))
        win.blit(text_title, (355, 20))
        win.blit(text_score, (365, 60))
        
        player1.update()
        player1.reset()
        player2.update()
        player2.reset()
        if sprite.collide_rect(ball, player1) or sprite.collide_rect(ball, player2):
                ball.speed *= -1
        ball.update()
        ball.reset()
        if ball.rect.x < 0:
            countP1 +=1
            ball.rect.x = 375 
            ball.rect.y = 275
            ball.speed *= -1
            if countP1 == 3:
                finish = True
                win.blit(lose1, (200, 200))
        if ball.rect.x > win_width:
            countP2 += 1
            ball.rect.x = 375 
            ball.rect.y = 275
            ball.speed *= -1
            if countP2 == 3:
                finish = True
                win.blit(lose2, (200, 200))
            


    display.update()
    clock.tick(fps)